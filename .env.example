# App
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000

# Database — PostgreSQL (local Docker or Supabase Cloud).
# Local: docker compose up -d db
DATABASE_URL=postgresql://soul:soul@localhost:5432/soulstar?schema=public

# Optional Supabase JS client (Auth.js still owns sessions).
# Fill these when pointing DATABASE_URL at a Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Seeded admin (created by prisma/seed.ts)
ADMIN_EMAIL=admin@soulstar.local
ADMIN_PASSWORD=ChangeMe_Admin_2026

# Payments
# mock | stripe | yookassa
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=RUB
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=

# Email
# mock | resend | smtp
EMAIL_PROVIDER=mock
EMAIL_FROM="Soul Star <noreply@localhost>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Meta Pixel + Conversions API
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=

# Optional public analytics
NEXT_PUBLIC_APP_NAME="Soul Star"

# Auto-translate readings to EN/AR on save.
# Default is Google Translate (no key). Set a key to use DeepL or OpenAI instead.
# TRANSLATE_PROVIDER=deepl | openai | google
DEEPL_API_KEY=
OPENAI_API_KEY=
OPENAI_TRANSLATE_MODEL=gpt-4o-mini
